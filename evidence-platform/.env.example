# ====================================================
# Evidence Assurance and Accountability Platform
# Environment Variables — copy to .env.local for development
# NEVER commit .env.local or any file with real secrets
# ====================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service key is server-only. Never expose in browser code or NEXT_PUBLIC_ vars.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- AI Provider (server-only) ---
# Set ANTHROPIC_API_KEY to use the Anthropic adapter.
# Leave blank to fall back to the deterministic mock provider (safe for local/test).
ANTHROPIC_API_KEY=

# Optional: OpenAI adapter (not implemented in MVP — reserved for future)
# OPENAI_API_KEY=

# Optional: Google adapter (not implemented in MVP — reserved for future)
# GOOGLE_AI_API_KEY=

# --- AI Provider selection ---
# Values: anthropic | mock
# Defaults to "mock" when ANTHROPIC_API_KEY is absent.
AI_PROVIDER=mock

# --- Security ---
# Random 32-byte hex string used for internal signing (e.g. webhook verification)
APP_SECRET=change_me_to_32_random_hex_characters

# --- Rate limiting ---
RATE_LIMIT_MAX_REQUESTS=50
RATE_LIMIT_WINDOW_MS=60000

# --- Optional Sentry (disabled unless set) ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Storage ---
# Private Supabase Storage bucket name for uploaded artifacts
ARTIFACT_STORAGE_BUCKET=case-artifacts

# --- Job polling ---
JOB_POLL_INTERVAL_MS=5000
JOB_MAX_ATTEMPTS=5

# --- URL Fetcher limits ---
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=2097152
FETCH_MAX_REDIRECTS=3

# --- File upload limits ---
MAX_FILE_SIZE_BYTES=15728640
